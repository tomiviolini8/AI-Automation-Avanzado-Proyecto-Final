{
  "name": "Worker2 - Redactar Respuesta",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "nombre", "type": "string" },
            { "name": "empresa", "type": "string" },
            { "name": "score", "type": "number" },
            { "name": "clasificacion", "type": "string" }
          ]
        }
      },
      "id": "w2-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-400, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Redactá un mail de seguimiento comercial para un lead. Devolvé SOLO un JSON (sin backticks) con la forma:\n{\"asunto\": \"<asunto>\", \"cuerpo\": \"<cuerpo del mail>\"}\n\nTono segun clasificacion:\n- CALIENTE: directo, propuesta concreta, ofrecer llamada esta semana.\n- TIBIO: nurturing, aportar valor, sin presionar.\n- FRIO: informativo y breve, dejar puerta abierta.\n\nFirmá como \"Equipo de Consultoria en Automatizacion e IA - La Plata\".\n\nNombre: {{ $json.nombre }}\nEmpresa: {{ $json.empresa }}\nScore: {{ $json.score }}\nClasificacion: {{ $json.clasificacion }}",
        "options": {}
      },
      "id": "w2-agent",
      "name": "AI Agent - Redaccion",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-160, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "w2-model",
      "name": "Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [-160, 500],
      "credentials": {}
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "p1", "name": "parsed", "value": "={{ JSON.parse($json.output) }}", "type": "object" }
          ]
        },
        "options": {}
      },
      "id": "w2-parse",
      "name": "Parse JSON Agent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [120, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "o1", "name": "status", "value": "success", "type": "string" },
            { "id": "o2", "name": "worker", "value": "redactar_respuesta", "type": "string" },
            { "id": "o3", "name": "data", "value": "={{ { \"asunto\": $json.parsed.asunto, \"cuerpo\": $json.parsed.cuerpo } }}", "type": "object" }
          ]
        },
        "options": {}
      },
      "id": "w2-out",
      "name": "Contrato Salida",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [360, 300]
    },
    {
      "parameters": {},
      "id": "w2-errtrigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [120, 520]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "status", "value": "error", "type": "string" },
            { "id": "e2", "name": "worker", "value": "redactar_respuesta", "type": "string" },
            { "id": "e3", "name": "message", "value": "Fallo en la redaccion de la respuesta", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "w2-err",
      "name": "Contrato Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [360, 520]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [[{ "node": "AI Agent - Redaccion", "type": "main", "index": 0 }]] },
    "Gemini Model": { "ai_languageModel": [[{ "node": "AI Agent - Redaccion", "type": "ai_languageModel", "index": 0 }]] },
    "AI Agent - Redaccion": { "main": [[{ "node": "Parse JSON Agent", "type": "main", "index": 0 }]] },
    "Parse JSON Agent": { "main": [[{ "node": "Contrato Salida", "type": "main", "index": 0 }]] },
    "Error Trigger": { "main": [[{ "node": "Contrato Error", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
