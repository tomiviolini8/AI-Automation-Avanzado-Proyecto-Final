{
  "name": "Worker1 - Calificar & Guardar Lead",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "nombre", "type": "string" },
            { "name": "empresa", "type": "string" },
            { "name": "mensaje", "type": "string" },
            { "name": "contacto", "type": "string" }
          ]
        }
      },
      "id": "w1-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-400, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analizá este lead comercial y devolvé SOLO un JSON (sin texto extra, sin backticks) con esta forma exacta:\n{\"score\": <numero 1-100>, \"clasificacion\": \"<CALIENTE|TIBIO|FRIO>\", \"motivo\": \"<breve>\"}\n\nCriterio de score:\n- Urgencia explícita, presupuesto mencionado, empresa mediana/grande, intención de compra clara => mayor score.\n- Consulta vaga, sin datos, curiosidad => menor score.\nCALIENTE >=70, TIBIO 40-69, FRIO <40.\n\nNombre: {{ $json.nombre }}\nEmpresa: {{ $json.empresa }}\nMensaje: {{ $json.mensaje }}\nContacto: {{ $json.contacto }}",
        "options": {}
      },
      "id": "w1-agent",
      "name": "AI Agent - Scoring",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-160, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "w1-model",
      "name": "Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [-160, 500],
      "credentials": {}
    },
    {
      "parameters": {
        "jsonMode": true,
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "parsed", "value": "={{ JSON.parse($json.output) }}", "type": "object" }
          ]
        },
        "options": {}
      },
      "id": "w1-parse",
      "name": "Parse JSON Agent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [120, 300]
    },
    {
      "parameters": {
        "resource": "record",
        "operation": "create",
        "base": { "__rl": true, "mode": "list", "value": "" },
        "table": { "__rl": true, "mode": "list", "value": "" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Nombre": "={{ $('Execute Workflow Trigger').item.json.nombre }}",
            "Empresa": "={{ $('Execute Workflow Trigger').item.json.empresa }}",
            "Contacto": "={{ $('Execute Workflow Trigger').item.json.contacto }}",
            "Mensaje": "={{ $('Execute Workflow Trigger').item.json.mensaje }}",
            "Score": "={{ $json.parsed.score }}",
            "Clasificacion": "={{ $json.parsed.clasificacion }}"
          }
        },
        "options": {}
      },
      "id": "w1-airtable",
      "name": "Airtable - Guardar Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [360, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "o1", "name": "status", "value": "success", "type": "string" },
            { "id": "o2", "name": "worker", "value": "calificar_lead", "type": "string" },
            { "id": "o3", "name": "data", "value": "={{ { \"lead_id\": $json.id, \"score\": $('Parse JSON Agent').item.json.parsed.score, \"clasificacion\": $('Parse JSON Agent').item.json.parsed.clasificacion } }}", "type": "object" }
          ]
        },
        "options": {}
      },
      "id": "w1-out",
      "name": "Contrato Salida",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [600, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "status", "value": "error", "type": "string" },
            { "id": "e2", "name": "worker", "value": "calificar_lead", "type": "string" },
            { "id": "e3", "name": "message", "value": "Fallo en la calificacion o guardado del lead", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "w1-err",
      "name": "Contrato Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [360, 520]
    },
    {
      "parameters": {},
      "id": "w1-errtrigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [120, 520]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [[{ "node": "AI Agent - Scoring", "type": "main", "index": 0 }]] },
    "Gemini Model": { "ai_languageModel": [[{ "node": "AI Agent - Scoring", "type": "ai_languageModel", "index": 0 }]] },
    "AI Agent - Scoring": { "main": [[{ "node": "Parse JSON Agent", "type": "main", "index": 0 }]] },
    "Parse JSON Agent": { "main": [[{ "node": "Airtable - Guardar Lead", "type": "main", "index": 0 }]] },
    "Airtable - Guardar Lead": { "main": [[{ "node": "Contrato Salida", "type": "main", "index": 0 }]] },
    "Error Trigger": { "main": [[{ "node": "Contrato Error", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
