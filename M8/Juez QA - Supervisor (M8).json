    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"exactitud_factual\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 5,\n      \"description\": \"Precisión factual del borrador contra la evidencia del manual (1 a 5)\"\n    },\n    \"estado_veredicto\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"ACEPTADO\",\n        \"CORREGIR\",\n        \"RECHAZADO\"\n      ],\n      \"description\": \"Ruta que debe tomar el borrador\"\n    },\n    \"categoria_error\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"ninguno\",\n        \"precio_incorrecto\",\n        \"plazo_incorrecto\",\n        \"dato_inventado\",\n        \"regla_no_se_mal_aplicada\",\n        \"consulta_no_respondida\",\n        \"sin_fuente\",\n        \"tono_inadecuado\",\n        \"riesgo_politica\"\n      ],\n      \"description\": \"Causa principal del error\"\n    },\n    \"critica\": {\n      \"type\": \"string\",\n      \"maxLength\": 400,\n      \"description\": \"Corrección accionable para el agente redactor\"\n    }\n  },\n  \"required\": [\n    \"exactitud_factual\",\n    \"estado_veredicto\",\n    \"categoria_error\",\n    \"critica\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "id": "b43b4397-b4af-4559-8ace-fd0d18093717",
      "name": "Structured Output Parser (JSON Schema)",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
